rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usernames sign in through Firebase Auth as <username>@arid.local.
    function usernameEmail(username) {
      return username + '@arid.local';
    }

    function signedIn() {
      return request.auth != null;
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isVerified() {
      return signedIn()
        && exists(myProfilePath())
        && get(myProfilePath()).data.verified == true;
    }

    function isAdmin() {
      return isVerified() && get(myProfilePath()).data.role == 'admin';
    }

    function onlyReviewFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['reviewStatus', 'reviewedAt', 'reviewedBy', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      // Registration. Mobile sign-ups are field reporters and verified at once;
      // web sign-ups are admins and stay unverified until another admin
      // verifies them. Nobody can register as a verified admin.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.username is string
        && request.auth.token.email == usernameEmail(request.resource.data.username)
        && (
          (request.resource.data.role == 'field' && request.resource.data.verified == true)
          || (request.resource.data.role == 'admin' && request.resource.data.verified == false)
        );

      // Owners keep their own profile and points up to date, but cannot change
      // who they are or whether they are verified. Verified admins can verify
      // or revoke anyone except themselves.
      allow update: if (
          signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['username', 'role', 'verified', 'verifiedAt', 'verifiedBy', 'createdAt'])
        ) || (
          isAdmin()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['verified', 'verifiedAt', 'verifiedBy', 'updatedAt'])
        );

      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == reportId;
      allow update: if (
          isVerified()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
        ) || (isAdmin() && onlyReviewFields());
      allow delete: if false;
    }
  }
}
